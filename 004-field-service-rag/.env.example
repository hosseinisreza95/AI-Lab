# --- Public OpenAI API (default) ---
OPENAI_API_KEY=sk-your-key-here

# --- Azure OpenAI (production deployment) ---
# Set AZURE_OPENAI_ENDPOINT to route every call through Azure instead.
# Deployment names must match CHAT_MODEL and EMBEDDING_MODEL below.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_API_VERSION=2024-10-21

CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Chunking ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Retrieval ---
VECTOR_TOP_K=12
KEYWORD_TOP_K=12
FINAL_TOP_K=5
RRF_K=60
RERANK_ENABLED=true
MIN_RERANK_SCORE=3.0

# --- Generation ---
TEMPERATURE=0.0
MAX_ANSWER_TOKENS=900
