OPENAI_API_KEY=sk-your-key-here

CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# The query builder does decomposition, not judgement, so it can stay cheap even
# if the answer model is upgraded.
QUERY_BUILDER_MODEL=gpt-4o-mini

# --- Retrieval ---
# Higher than a typical RAG setup on purpose: a coverage answer usually rests on
# four or five clauses (benefit, waiting period, exclusion, definition), and each
# search query contributes its own candidates.
VECTOR_TOP_K=15
KEYWORD_TOP_K=15
FINAL_TOP_K=8
RRF_K=60

TEMPERATURE=0.0
MAX_ANSWER_TOKENS=1200

# --- Streamlit UI ---
API_URL=http://localhost:8000
API_TIMEOUT=90
