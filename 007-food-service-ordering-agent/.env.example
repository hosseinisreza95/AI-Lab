OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-4o-mini

# Optional LangSmith tracing, same setup as EXP-002.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=food-service-agent

# --- Human in the loop ---
# The graph interrupts before send_purchase_order so the manager confirms an
# order they have actually seen. Turning this off lets the agent email a supplier
# directly from a chat message. Leave it on.
REQUIRE_ORDER_CONFIRMATION=true

# --- Email ---
# Dry run writes the purchase order to outbox/<PO>.eml instead of sending it.
# Set to false only once you intend real mail to reach a real supplier.
EMAIL_DRY_RUN=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- Site identity, printed on the purchase order ---
SITE_NAME=Staff Restaurant - Site 01
SITE_ADDRESS=12 rue de l'Industrie, 69100 Villeurbanne, France
SITE_EMAIL=site01@foodservice.example
