OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-4o-mini

# --- Feature engine ---
# Spark is used automatically when pyspark is importable AND a JVM is present.
# Set FORCE_PANDAS=true to pin the pandas engine even where Spark would work,
# which is how the parity test is run on a machine that has both.
FORCE_PANDAS=
SPARK_SHUFFLE_PARTITIONS=8
# JAVA_HOME=/opt/java/openjdk
