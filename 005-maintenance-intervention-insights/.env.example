OPENAI_API_KEY=sk-your-key-here

# Stage 1 does structured extraction, stage 2 writes prose. Kept separate so the
# reporting model can be upgraded without re-running extraction over the archive.
STRUCTURING_MODEL=gpt-4o-mini
REPORTING_MODEL=gpt-4o-mini

# Records below this extraction confidence are flagged in the report's data
# quality note. They are still stored - a flagged record is recoverable, a
# dropped one is not.
CONFIDENCE_FLOOR=0.6
